# ===========================================
# Club Connect — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=clubconnect
DB_PASSWORD=changeme
DB_NAME=clubconnect
DB_SSLMODE=disable


# --- Instagram Scraper (RapidAPI) ---
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=your_rapidapi_host

# --- Server ---
PORT=8080
GIN_MODE=debug

# --- Scraper ---
SCRAPE_INTERVAL=30m
SCRAPE_WORKERS=3

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
