# Copy this file to .env and fill in your values.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=clubconnect
DB_PASSWORD=changeme
DB_NAME=clubconnect
DB_SSLMODE=disable


# --- Server ---
PORT=8080
GIN_MODE=debug

# --- Scraper ---
SCRAPE_INTERVAL=30m
SCRAPE_WORKERS=3
